# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# OS files
.DS_Store
Thumbs.db

# Data files (allow train.csv and processed parquet splits in Git so teammates have immediate access)
data/raw/*
!data/raw/.gitkeep
!data/raw/train.csv
data/external/*
!data/external/.gitkeep
data/processed/*
!data/processed/.gitkeep
!data/processed/*.parquet

# Saved model binaries
models/*.pkl
models/*.joblib
